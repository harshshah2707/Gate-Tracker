# ============================================================
# GATE WARROOM 2026 - Production Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_strong_password_here
POSTGRES_DB=gatewarroom
DATABASE_URL=postgresql://postgres:changeme_strong_password_here@db:5432/gatewarroom?schema=public

# --- Backend ---
JWT_SECRET=change_this_to_a_very_long_random_string_at_least_64_chars
PORT=5000
NODE_ENV=production

# --- Frontend ---
# Set this to your backend's public URL after deploying
NEXT_PUBLIC_API_URL=https://your-backend-url.railway.app

# --- Ports (local docker-compose only) ---
BACKEND_PORT=5000
FRONTEND_PORT=3000
